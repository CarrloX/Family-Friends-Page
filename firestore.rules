rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Función de autorización estricta en el servidor.
    // La seguridad y el control de acceso residen en las reglas del servidor (BaaS),
    // no en la interfaz del cliente. Se exige de forma obligatoria que el token
    // de autenticación contenga el Custom Claim verificado: admin == true.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Configuración del grupo y miembros
    match /grupo/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Estado de la votación activa
    match /votacion_actual/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Historial de votaciones pasadas
    match /votaciones_pasadas/{doc} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
  }
}

