rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /grupo/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /votaciones_pasadas/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /votacion_actual/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
