rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /grupo/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /votacion_actual/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /votaciones_pasadas/{doc} {
      allow read: if true;
      allow write, delete: if request.auth != null;
    }
  }
}
